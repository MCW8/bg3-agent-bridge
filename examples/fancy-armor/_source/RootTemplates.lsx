<?xml version="1.0" encoding="utf-8"?>
<!--
  SOURCE FILE — not shipped as-is.

  Build step:
    divine -g bg3 -a convert-resource \
      -s _source/RootTemplates.lsx \
      -d Public/FancyArmor/RootTemplates/_merged.lsf

  The game loads root templates from Public/<Mod>/RootTemplates/_merged.lsf —
  a fixed filename, in binary LSF. An arbitrarily named .lsx dropped in that
  folder is silently ignored: the stat entry still loads, so the item exists
  on paper while its template does not, and spawning it does nothing.

  Keeping the .lsx around matters because LSF is binary and drops these
  comments entirely.
-->
<save>
  <version major="4" minor="0" revision="9" build="0" />
  <region id="Templates">
    <node id="Templates">
      <children>
        <!--
          Inherits ARM_Plate_Dwarven, which is where the plate appearance comes
          from: ParentTemplateId brings VisualTemplate and Icon along, so neither
          needs restating here. Only Stats is overridden, and that is what
          decouples how it looks from how it behaves.

          Stats and template cross-reference each other — this points at
          ARM_FancyArmor, and ARM_FancyArmor's RootTemplate points back at this
          MapKey. Shipped transmog mods warn loudly about items where that pair
          does not agree.
        -->
        <node id="GameObjects">
          <attribute id="MapKey" type="FixedString" value="ff2c72c3-7301-4f6f-bcad-3f98711a0321" />
          <attribute id="Name" type="LSString" value="ARM_FancyArmor" />
          <attribute id="ParentTemplateId" type="FixedString" value="b4c754d8-94ef-4df2-9dbd-2fbc4311f53b" />
          <attribute id="Type" type="FixedString" value="item" />
          <attribute id="Stats" type="FixedString" value="ARM_FancyArmor" />
          <attribute id="LevelName" type="FixedString" value="" />
          <attribute id="DisplayName" type="TranslatedString" handle="hc09d79b4g0160g49ebga073g6f50142fc4ff" version="1" />
          <attribute id="Description" type="TranslatedString" handle="h2c9e14c7ga0d4g4d42g9ca4gf07167e4e555" version="1" />
        </node>
      </children>
    </node>
  </region>
</save>
