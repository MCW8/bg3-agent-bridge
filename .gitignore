node_modules/
dist/
*.tsbuildinfo
*.log
# Bun's --compile writes a temp next to the output; a failed move can leave one behind.
.*.bun-build

# Build-time-only tools (bun.exe for the exe build) — downloaded, never committed
tools/

# Machine-local Claude Code state
.claude/settings.local.json

# Machine-local MCP config — the server path is specific to each install
.mcp.json

# Never commit extracted game data or built packages — Larian's Toolkit EULA
# forbids redistributing Toolkit output and game assets.
*.pak
/gamedata/
/unpacked/
